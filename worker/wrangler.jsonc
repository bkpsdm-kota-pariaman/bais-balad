{
  "name": "absensi-kegiatan-asn-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-06-26",
  "kv_namespaces": [
    {
      "id": "93df20ab114c4344be203886c380d7a2",
      "binding": "JADWAL_KV"
    },
    {
      "id": "21afac99b32b4c19a6289a3002f0ee97",
      "binding": "OPD_KV"
    },
    {
      "id": "1bdb1488a21b4c699aa53de6bbcb7b9d",
      "binding": "PEGAWAI_KV"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MY_QUEUE",
        "queue": "absensi-kegiatan-asn-worker"
      }
    ],
    "consumers": [
      {
        "queue": "absensi-kegiatan-asn-worker",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "env": {
    "beta": {
      "name": "absensi-kegiatan-asn-worker-dev",
      "vars": {
        "ORIGIN_API_URL": "https://api-esdm.pariamankota.go.id/beta-bais-pariaman/api"
      },
      "kv_namespaces": [
        {
          "id": "903fb3891f7142269f5292abef2cc9a4",
          "binding": "JADWAL_KV"
        },
        {
          "id": "288917f93faa414b8e13736b0743c283",
          "binding": "OPD_KV"
        },
        {
          "id": "1f8f10aa5565442f8adedc45afa8e63c",
          "binding": "PEGAWAI_KV"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "MY_QUEUE",
            "queue": "absensi-kegiatan-asn-worker-dev"
          }
        ],
        "consumers": [
          {
            "queue": "absensi-kegiatan-asn-worker-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5
          }
        ]
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      }
    }
  }
}